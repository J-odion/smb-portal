# ==============================================================================
# WEB SCOPED ENVIRONMENT VARIABLES (apps/web/.env.example)
#
# INSTRUCTIONS:
# Copy this file to apps/web/.env.local for local frontend development.
# ==============================================================================

# Next.js Server Port
PORT=3000

# Public API URL (Render Production Backend)
NEXT_PUBLIC_API_URL="https://smb-portal-1.onrender.com"

# Internal API URL (Used by Next.js server rewrites)
API_URL="https://smb-portal-1.onrender.com"

# App Branding
NEXT_PUBLIC_APP_NAME="SMB Portal"
