# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file and rename it to .env (or .env.local)
# 2. NEVER commit your actual .env file to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# The connection URL for your PostgreSQL database. 
# If using Supabase or Neon, ensure you use the connection pooled URL.
DATABASE_URL="postgresql://user:password@host:port/database?schema=public"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION (NESTJS)
# ------------------------------------------------------------------------------
# A highly secure, random string used to sign JWT tokens. 
# Generate one using: openssl rand -base64 32
JWT_SECRET="replace-this-with-a-super-secret-random-string"

# Token expiration time (e.g., 1d, 8h)
JWT_EXPIRES_IN="1d"

# ------------------------------------------------------------------------------
# 3. FRONTEND / NEXT.JS CONFIGURATION
# ------------------------------------------------------------------------------
# The base URL where your NestJS API is hosted (e.g. https://api.yourdomain.com)
NEXT_PUBLIC_API_URL="http://localhost:3001"

# ------------------------------------------------------------------------------
# 4. SERVER CONFIGURATION (NESTJS)
# ------------------------------------------------------------------------------
# Port for the NestJS server (usually automatically provided by Render/Railway)
PORT=3001

# Environment (development | production)
NODE_ENV="development"
